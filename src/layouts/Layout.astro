---
import Header from '../components/layouts/Header.astro';
import Footer from '../components/layouts/Footer.astro';
import ImageModal from '../components/common/ImageModal.astro';
import SiteFonts from '../components/common/SiteFonts.astro';
import ThemeInit from '../components/common/ThemeInit.astro';
import defaultShareImage from '../assets/me.png';

import '../styles/index.css';

interface Props {
	/** 分頁標題，會直接進 <title> 與 og:title */
	title: string;
	/** 一句話摘要，進 meta description 與 og:description；未給則用站台預設 */
	description?: string;
	/** 分享縮圖的網址（通常是文章 frontmatter 的 image）；未給則用站台預設圖 */
	image?: string;
	/** 文章頁傳 'article'，其餘維持 'website' */
	type?: 'website' | 'article';
	/** 文章發布日期（ISO），只有 type='article' 時有意義 */
	publishedTime?: string;
	/** 覆寫 canonical；預設用當前路徑 */
	canonical?: string | URL;
	/** 讓搜尋引擎不要收錄此頁（例如 404） */
	noindex?: boolean;
}

const SITE_NAME = 'Coding Afternoon';
const DEFAULT_DESCRIPTION = '軟體開發技術分享：架構、測試、AI 協作與日常踩坑筆記。';

const {
	title,
	description = DEFAULT_DESCRIPTION,
	image,
	type = 'website',
	publishedTime,
	canonical,
	noindex = false,
} = Astro.props;

// Astro.site 由 astro.config.mjs 提供，靜態建置時一定存在
const canonicalUrl = new URL(canonical ?? Astro.url.pathname, Astro.site);
const shareImageUrl = new URL(image ?? defaultShareImage.src, Astro.site);
---

<!doctype html>
<html lang="zh-Hant-TW">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0" />
		<meta name="generator" content={Astro.generator} />

		<meta name="description" content={description} />
		<link rel="canonical" href={canonicalUrl} />
		{noindex && <meta name="robots" content="noindex, follow" />}

		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="sitemap" href="/sitemap-index.xml" />
		<link rel="alternate" type="application/rss+xml" title={`${SITE_NAME} RSS Feed`} href="/rss.xml" />

		<!-- Open Graph -->
		<meta property="og:type" content={type} />
		<meta property="og:site_name" content={SITE_NAME} />
		<meta property="og:locale" content="zh_TW" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonicalUrl} />
		<meta property="og:image" content={shareImageUrl} />
		{publishedTime && <meta property="article:published_time" content={publishedTime} />}

		<!-- Twitter -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={shareImageUrl} />

		<SiteFonts />

		<title>{title}</title>

		<ThemeInit />
	</head>
	<body class="min-h-screen flex flex-col">
		<a href="#main" class="skip-link">跳到主要內容</a>
		<Header />
		<main id="main" class="flex-grow w-full">
			<slot />
		</main>
		<Footer />
		<ImageModal />

	</body>
</html>

<style is:global>
	.skip-link {
		position: absolute;
		left: 1rem;
		top: -3rem;
		z-index: 50;
		padding: 0.5rem 0.75rem;
		border-radius: var(--radius);
		background-color: var(--color-ink);
		color: var(--color-bg);
	}

	.skip-link:focus {
		top: 1rem;
	}
</style>
