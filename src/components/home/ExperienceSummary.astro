---
import { experiences } from '../../config/introduce.json';

/**
 * 首頁只列最近幾段經歷，其餘看完整履歷。
 * introduce.json 的經歷依新到舊維護，所以取前幾筆就是最近的。
 */
const RECENT_EXPERIENCE_COUNT = 3;

const recentExperiences = experiences.slice(0, RECENT_EXPERIENCE_COUNT);
---

<section class="mx-auto mt-16 max-w-3xl px-4 sm:px-6" aria-labelledby="experience-title">
  <div class="flex items-baseline justify-between border-b border-line pb-3">
    <h2 id="experience-title" class="font-serif text-xl font-bold text-ink">經歷</h2>
    <a href="/cv" class="text-sm text-muted hover:text-accent">完整履歷 →</a>
  </div>
  <ol class="divide-y divide-line">
    {recentExperiences.map(experience => (
      <li class="flex flex-col gap-1 py-4 sm:flex-row sm:gap-6" data-home-experience>
        <p class="w-32 shrink-0 text-sm text-muted">{experience.years}</p>
        <div>
          <p class="font-medium text-ink">{experience.title}</p>
          <p class="text-sm text-muted">{experience.sub_title}</p>
        </div>
      </li>
    ))}
  </ol>
</section>
