---
import HomeSection from './HomeSection.astro';
import ArticleListItem from '../blog/ArticleListItem.astro';
import SeriesEntry from '../blog/SeriesEntry.astro';
import { selectNewestSeries, selectStandaloneArticles, type BlogEntry } from '../../utils/series';

interface Props {
  /** 已發布的文章（草稿已濾掉） */
  blogs: BlogEntry[];
}

/** 首頁列出的最新單篇文章篇數（系列文章由系列入口代表，不列在這裡） */
const LATEST_ARTICLE_COUNT = 5;

const { blogs } = Astro.props;
// 首頁介紹的是「最新開始的系列」，不是文章列表頁的「最近更新的系列」
const newestSeries = selectNewestSeries(blogs);
const latestArticles = selectStandaloneArticles(blogs).slice(0, LATEST_ARTICLE_COUNT);
---

<HomeSection title="home.latestArticles" titleId="latest-title" link={{ href: "/blogs", label: "home.allArticles" }}>
  {newestSeries && (
    <div class="mt-6" data-home-series>
      <SeriesEntry series={newestSeries} label="series.newest" />
    </div>
  )}

  <div class="divide-y divide-line" data-home-latest>
    {latestArticles.map((blog, index) => (
      <ArticleListItem blog={blog} isFirst={index === 0} />
    ))}
  </div>
</HomeSection>
