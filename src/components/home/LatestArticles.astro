---
import HomeSection from './HomeSection.astro';
import ArticleListItem from '../blog/ArticleListItem.astro';
import SeriesEntry from '../blog/SeriesEntry.astro';
import { selectLatestArticles, selectLatestSeries, type BlogEntry } from '../../utils/series';

interface Props {
  /** 已發布的文章（草稿已濾掉） */
  blogs: BlogEntry[];
}

/** 首頁列出的最新文章篇數 */
const LATEST_ARTICLE_COUNT = 5;

const { blogs } = Astro.props;
const latestSeries = selectLatestSeries(blogs);
const latestArticles = selectLatestArticles(blogs, LATEST_ARTICLE_COUNT);
---

<HomeSection title="最新文章" titleId="latest-title" link={{ href: "/blogs", label: "所有文章 →" }}>
  {latestSeries && (
    <div class="mt-6" data-home-series>
      <SeriesEntry series={latestSeries} label="進行中的系列" />
    </div>
  )}

  <div class="divide-y divide-line" data-home-latest>
    {latestArticles.map((blog, index) => (
      <ArticleListItem blog={blog} isFirst={index === 0} />
    ))}
  </div>
</HomeSection>
