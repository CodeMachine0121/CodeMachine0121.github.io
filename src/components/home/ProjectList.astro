---
import { projects } from '../../config/introduce.json';
---

<section class="mx-auto mt-16 max-w-3xl px-4 sm:px-6" aria-labelledby="projects-title">
  <h2 id="projects-title" class="border-b border-line pb-3 font-serif text-xl font-bold text-ink">作品</h2>
  <ul class="divide-y divide-line">
    {projects.map(project => (
      <li data-home-project>
        <a href={project.link} target="_blank" rel="noopener noreferrer" class="group flex items-start justify-between gap-4 py-4">
          <div class="min-w-0">
            <p class="text-xs font-medium uppercase tracking-wide text-muted">{project.type.en}</p>
            <p class="mt-1 font-medium leading-snug text-ink group-hover:text-accent">{project.title.en}</p>
          </div>
          <span class="mt-5 shrink-0 text-muted group-hover:text-accent" aria-hidden="true">↗</span>
        </a>
      </li>
    ))}
  </ul>
</section>
