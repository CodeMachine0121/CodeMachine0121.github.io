---
import ReadingTime from './ReadingTime.astro';
import UiText from '../common/UiText.astro';
import { formatPublishedDate, inBothLanguages } from '../../utils/ui-language';
import type { BlogEntry } from '../../utils/series';

interface Props {
  blog: BlogEntry;
  class?: string;
}

const { blog, class: className = '' } = Astro.props;
const publishedDate = inBothLanguages(language => formatPublishedDate(blog.data.datetime, language));
---

<p class:list={['flex flex-wrap items-center gap-x-2 text-sm text-muted', className]}>
  <time datetime={blog.data.datetime}><UiText text={publishedDate} /></time>
  <span aria-hidden="true">·</span>
  <ReadingTime markdown={blog.body} />
</p>
