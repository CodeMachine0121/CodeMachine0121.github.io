---
import UiText from '../common/UiText.astro';
import type { BlogEntry } from '../../utils/series';
import { uiAttributes } from '../../utils/ui-language';

interface Props {
  prevPost: BlogEntry | null;
  nextPost: BlogEntry | null;
}

const { prevPost, nextPost } = Astro.props;
---

{(prevPost || nextPost) && (
  <nav class="mt-12 grid gap-4 border-t border-line pt-8 sm:grid-cols-2" {...uiAttributes({ 'aria-label': 'post.adjacent' })}>
    <div>
      {prevPost && (
        <a href={`/blogs/${prevPost.id}`} class="group block rounded border border-line p-4 hover:border-accent">
          <p class="text-sm text-muted"><UiText text="post.previous" /></p>
          <p class="mt-1 font-serif font-bold leading-snug text-ink group-hover:text-accent" data-content>{prevPost.data.title}</p>
        </a>
      )}
    </div>
    <div class="sm:text-right">
      {nextPost && (
        <a href={`/blogs/${nextPost.id}`} class="group block rounded border border-line p-4 hover:border-accent">
          <p class="text-sm text-muted"><UiText text="post.next" /></p>
          <p class="mt-1 font-serif font-bold leading-snug text-ink group-hover:text-accent" data-content>{nextPost.data.title}</p>
        </a>
      )}
    </div>
  </nav>
)}
