---
import ArticleMeta from './ArticleMeta.astro';
import type { BlogEntry } from '../../utils/series';

interface Props {
  blog: BlogEntry;
  /** 列表第一篇的封面不延遲載入 */
  isFirst?: boolean;
  /** 在系列頁裡就不用再重複標系列名 */
  showSeries?: boolean;
}

const { blog, isFirst = false, showSeries = true } = Astro.props;
const seriesName = showSeries ? blog.data.parent : undefined;
---

<article class="group relative flex gap-5 py-6">
  <div class="min-w-0 flex-1">
    {seriesName && (
      <p class="mb-1 text-xs font-medium uppercase tracking-wide text-accent" data-content>{seriesName}</p>
    )}
    <h2 class="font-serif text-xl font-bold leading-snug text-ink group-hover:text-accent" data-content>
      <a href={`/blogs/${blog.id}`} class="after:absolute after:inset-0">
        {blog.data.title}
      </a>
    </h2>
    {blog.data.description && (
      <p class="mt-2 line-clamp-2 text-muted" data-content>{blog.data.description}</p>
    )}
    <ArticleMeta blog={blog} class="mt-3" />
  </div>
  {blog.data.image && (
    <img
      src={blog.data.image}
      alt=""
      loading={isFirst ? 'eager' : 'lazy'}
      class="hidden h-24 w-36 shrink-0 rounded object-cover sm:block"
    />
  )}
</article>
