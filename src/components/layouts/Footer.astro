---
import { Icon } from "astro-icon/components";
import { socialLinks, basic } from "../../config/introduce.json";

const year = new Date().getFullYear();
---

<footer class="mt-24 border-t border-line">
    <div class="mx-auto flex max-w-page flex-col gap-6 px-4 py-10 text-sm text-muted sm:flex-row sm:items-center sm:justify-between sm:px-6">
        <div>
            <p class="font-serif text-base font-bold text-ink">{basic?.site_name}</p>
            <p class="mt-1">© {year} {basic?.name} · <a href="/rss.xml" class="hover:text-accent">RSS</a></p>
        </div>

        <ul class="flex items-center gap-2" aria-label="社群連結">
            {socialLinks.map(social => (
                <li>
                    <a href={social.link} target="_blank" rel="noopener noreferrer"
                       class="inline-flex h-9 w-9 items-center justify-center rounded text-muted hover:text-accent"
                       aria-label={social.iconName}>
                        <Icon name={social.iconName} class="size-5" />
                    </a>
                </li>
            ))}
        </ul>
    </div>
</footer>
