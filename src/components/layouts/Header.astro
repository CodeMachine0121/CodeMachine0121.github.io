---
import ThemeToggle from "../common/ThemeToggle.astro";
import { basic, menuItems } from "../../config/introduce.json";

const currentPath = Astro.url.pathname;
// 首頁只在完全相符時算「目前所在」；其餘以路徑前綴判斷（/blogs/xxx 也算 Blog）
const isCurrent = (link: string) =>
  link === "/" ? currentPath === "/" : currentPath.startsWith(link);
---

<header class="sticky top-0 z-30 border-b border-line bg-bg/90 backdrop-blur">
  <div class="mx-auto flex h-14 max-w-page items-center justify-between gap-4 px-4 sm:px-6">
    <a href="/" class="font-serif text-lg font-bold tracking-tight text-ink hover:text-accent">
      {basic?.site_name}
    </a>

    <div class="flex items-center gap-1 sm:gap-2">
      <nav aria-label="主要導覽">
        <ul class="flex items-center gap-1 text-sm sm:gap-2">
          {menuItems.map((item) => (
            <li>
              <a
                href={item.link}
                class:list={[
                  "rounded px-2 py-1.5 hover:text-accent",
                  isCurrent(item.link) ? "text-ink font-medium" : "text-muted",
                ]}
                aria-current={isCurrent(item.link) ? "page" : undefined}
              >
                {item.name.en}
              </a>
            </li>
          ))}
        </ul>
      </nav>
      <ThemeToggle />
    </div>
  </div>
</header>
