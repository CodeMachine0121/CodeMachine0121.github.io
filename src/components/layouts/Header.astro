---
import ThemeToggle from "../common/ThemeToggle.astro";
import LanguageToggle from "../common/LanguageToggle.astro";
import UiText from "../common/UiText.astro";
import { uiAttributes } from "../../utils/ui-language";
import { basic, menuItems } from "../../config/introduce.json";

const currentPath = Astro.url.pathname;
// 首頁只在完全相符時算「目前所在」；其餘以路徑前綴判斷（/blogs/xxx 也算 Blog）
const isCurrent = (link: string) =>
  link === "/" ? currentPath === "/" : currentPath.startsWith(link);
---

<header class="sticky top-0 z-30 site-header border-b border-line backdrop-blur">
  {/* 窄螢幕：站名＋主題鈕一列、導覽另起一列；寬螢幕全部同一列 */}
  <div class="mx-auto flex max-w-page flex-wrap items-center justify-between gap-x-4 px-4 py-2 sm:h-14 sm:flex-nowrap sm:py-0 sm:px-6">
    <a href="/" translate="no" class="whitespace-nowrap font-serif text-lg font-bold tracking-tight text-ink hover:text-accent">
      {basic?.site_name}
    </a>

    <div class="contents sm:flex sm:items-center sm:gap-2">
      <nav {...uiAttributes({ "aria-label": "site.mainNavigation" })} class="order-last -ml-2 w-full sm:order-none sm:ml-0 sm:w-auto">
        <ul class="flex items-center gap-1 whitespace-nowrap text-sm sm:gap-2">
          {menuItems.map((item) => (
            <li>
              <a
                href={item.link}
                class:list={[
                  "rounded px-2 py-1.5 hover:text-accent",
                  isCurrent(item.link) ? "text-ink font-medium" : "text-muted",
                ]}
                aria-current={isCurrent(item.link) ? "page" : undefined}
              >
                <UiText text={item.name} />
              </a>
            </li>
          ))}
        </ul>
      </nav>
      <div class="flex items-center">
        <LanguageToggle />
        <ThemeToggle />
      </div>
    </div>
  </div>
</header>

<style>
  /* Tailwind 的透明度修飾（bg-bg/90）對 CSS 變數色無效，改用 color-mix 從 token 調出半透明底 */
  .site-header {
    background-color: var(--color-bg);
    background-color: color-mix(in srgb, var(--color-bg) 90%, transparent);
  }
</style>
