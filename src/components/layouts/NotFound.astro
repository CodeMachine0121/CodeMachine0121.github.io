---
import LinkButton from '../common/LinkButton.astro';
import UiText from '../common/UiText.astro';
---

<section class="mx-auto flex min-h-[60vh] max-w-3xl flex-col justify-center px-4 py-16 sm:px-6">
    <p class="text-sm font-medium uppercase tracking-wide text-accent">404</p>
    <h1 class="mt-3 font-serif text-3xl font-bold text-ink sm:text-4xl"><UiText text="notFound.title" /></h1>
    <p class="mt-4 text-lg text-muted"><UiText text="notFound.description" /></p>
    <div class="mt-8 flex flex-wrap gap-3">
        <LinkButton href="/"><UiText text="notFound.home" /></LinkButton>
        <LinkButton href="/blogs" variant="secondary"><UiText text="notFound.articles" /></LinkButton>
    </div>
</section>
