---
interface Props {
  label?: string;
}
const { label = 'Save as PDF' } = Astro.props;
---

<button id="print-pdf-btn" class="no-print cv-download-btn" type="button">
  <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
    <path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
  </svg>
  <span>{label}</span>
</button>

<script>
  // The PDF is produced by the browser's own print pipeline rather than a
  // canvas snapshot, so the output keeps a real text layer: selectable,
  // searchable, and parseable by applicant tracking systems. Layout,
  // pagination and page size come from the @media print rules in cv.scss.
  const btn = document.getElementById('print-pdf-btn');

  btn?.addEventListener('click', async () => {
    // Sections start at opacity 0 until the IntersectionObserver reveals them.
    // The print stylesheet forces them visible, but waiting on fonts first
    // avoids a fallback-font first page in some browsers.
    await document.fonts.ready;
    window.print();
  });
</script>
