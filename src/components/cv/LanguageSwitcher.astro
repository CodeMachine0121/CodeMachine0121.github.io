---
import type { Language } from '../../types/cv';
import { uiText } from '../../utils/ui-language';

interface Props {
  currentLang: Language;
}

const { currentLang } = Astro.props;
const otherLang: Language = currentLang === 'en' ? 'zh' : 'en';
const otherLangLabel = otherLang === 'en' ? 'EN' : '中文';
---

<button
  type="button"
  class="cv-lang-switch no-print"
  data-target-language={otherLang}
  aria-label={uiText('cv.switchLanguage', currentLang)}
  title={uiText('cv.switchLanguage', currentLang)}
>
  {otherLangLabel}
</button>

<script>
  // 在履歷上切換語言視為讀者的語言選擇：記住後再前往另一個版本
  import { chooseLanguage } from '../../scripts/language';

  for (const button of document.querySelectorAll<HTMLButtonElement>('[data-target-language]')) {
    button.addEventListener('click', () => {
      const language = button.dataset.targetLanguage === 'zh' ? 'zh' : 'en';
      chooseLanguage(language);
      window.location.href = `/cv/${language}`;
    });
  }
</script>

<style>
  .cv-lang-switch {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0.375rem 0.75rem;
    font-family: var(--font-sans);
    font-size: 0.875rem;
    font-weight: 500;
    background: var(--color-surface);
    color: var(--color-muted);
    border: 1px solid var(--color-line);
    border-radius: 0.5rem;
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.05);
    cursor: pointer;
    transition: all 150ms ease-in-out;
  }

  .cv-lang-switch:hover {
    background: var(--color-bg);
    color: var(--color-ink);
    border-color: var(--color-accent);
  }

  .cv-lang-switch:active {
    transform: scale(0.95);
  }

  @media (max-width: 768px) {
    .cv-lang-switch {
      padding: 0.375rem 0.625rem;
      font-size: 0.8125rem;
    }
  }
</style>
