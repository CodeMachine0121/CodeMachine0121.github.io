---
import CVSection from './CVSection.astro';
import { getLocalizedText } from '../../utils/i18n';
import type { ProjectItem, Language } from '../../types/cv';

interface Props {
  items: ProjectItem[];
  lang?: Language;
}
const { items, lang = 'en' } = Astro.props;

const visibleItems = items.filter(p => p.title.en);

---

<CVSection title={lang === 'zh' ? '專案、演講與認證' : 'Projects, Talks & Certifications'}>
  <ul class="cv-projects-list">
    {visibleItems.map((item) => {
      const localizedType = getLocalizedText(item.type, lang);
      const description = item.description ? getLocalizedText(item.description, lang) : '';
      return (
        <li class="cv-project-row">
          <div class="cv-project-main">
            <span class="cv-project-title">
              {item.link ? (
                <a
                  href={item.link}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="cv-project-link"
                >
                  {getLocalizedText(item.title, lang)}
                </a>
              ) : (
                <span class="cv-project-text">{getLocalizedText(item.title, lang)}</span>
              )}
            </span>
            {description && <span class="cv-project-desc">{description}</span>}
          </div>
          <span class="cv-badge">
            {localizedType}
          </span>
        </li>
      );
    })}
  </ul>
</CVSection>
