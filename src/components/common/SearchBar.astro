---
import UiText from './UiText.astro';
import { uiAttributes, type UiTextKey } from '../../utils/ui-language';

export interface Props {
  placeholder: UiTextKey;
  /** 輸入框的可存取名稱（不會顯示，但螢幕閱讀器會讀） */
  label: UiTextKey;
  class?: string;
}

const { placeholder, label, class: className = '' } = Astro.props;
---

<div class:list={['relative', className]}>
  <svg
    class="pointer-events-none absolute left-3 top-1/2 h-4 w-4 -translate-y-1/2 text-muted"
    aria-hidden="true"
    xmlns="http://www.w3.org/2000/svg"
    viewBox="0 0 20 20"
    fill="none"
  >
    <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m19 19-4-4m0-7A7 7 0 1 1 1 8a7 7 0 0 1 14 0Z" />
  </svg>
  <label class="sr-only" for="blog-search"><UiText text={label} /></label>
  <input
    type="search"
    id="blog-search"
    class="w-full rounded border border-line bg-surface py-2.5 pl-9 pr-3 text-ink placeholder:text-muted focus:border-accent focus:outline-none"
    {...uiAttributes({ placeholder })}
    autocomplete="off"
  />
</div>
