---
import BlogItem from './BlogItem.astro';
import ParentItem from './ParentItem.astro';
import SearchBar from '../../common/SearchBar.astro';
import { selectLatestSeries, selectStandaloneArticles, type BlogEntry } from '../../../utils/series';

interface Props {
  blogs: BlogEntry[];
}

const { blogs } = Astro.props;

// 這一頁的主角是單篇文章，系列只掛「目前進行中」那一個的入口，
// 其餘系列走 /series。哪一個算最新由資料決定，不寫死系列名稱。
const latestSeries = selectLatestSeries(blogs);
const standaloneBlogs = selectStandaloneArticles(blogs);

// 該系列的文章預設不列出（點卡片會進系列頁），但仍放進 DOM 讓搜尋找得到。
const latestSeriesArticles = latestSeries?.articles ?? [];
---

<section class="py-12">
  <div class="container mx-auto px-4 max-w-4xl">
    <div class="text-center mb-10">
      <span class="hd-label">Blog</span>
      <h1 class="font-heading text-4xl sm:text-5xl text-ink mt-5">Recent posts</h1>
      <span class="hd-squiggle mx-auto mt-5" aria-hidden="true"></span>
    </div>

    <!-- 搜尋列 -->
    <div class="mb-8">
      <SearchBar placeholder="搜尋文章標題或系列..." label="搜尋文章標題或系列" />
    </div>

    <!-- 進行中的系列 -->
    {latestSeries && (
      <div id="series-list" class="mb-6">
        <div class="series-card" data-series-name={latestSeries.name}>
          <ParentItem
            parentName={latestSeries.name}
            childrenCount={latestSeries.count}
            href={`/series/${latestSeries.slug}`}
          />
        </div>
      </div>
    )}

    <!-- 文章列表 -->
    <div id="blog-list" class="space-y-6">
      {standaloneBlogs.map((blog, index) => (
        <div class="blog-item" data-series="">
          <BlogItem blog={blog} isFirst={index === 0} />
        </div>
      ))}

      {/* 進行中系列的文章：預設隱藏，只在搜尋命中時出現 */}
      {latestSeriesArticles.map(blog => (
        <div class="blog-item hidden" data-series={latestSeries!.name}>
          <BlogItem blog={blog} isFirst={false} />
        </div>
      ))}
    </div>

    <!-- 無搜尋結果提示 -->
    <div id="no-results" class="hidden text-center py-12">
      <p class="font-heading text-2xl text-ink">沒有找到符合的文章</p>
      <p class="text-ink-soft mt-2">試試其他關鍵字</p>
    </div>
  </div>
</section>

<script>
  function initBlogSearch() {
    const searchInput = document.querySelector<HTMLInputElement>('#blog-search');
    const blogItems = Array.from(document.querySelectorAll<HTMLElement>('.blog-item'));
    const seriesCards = Array.from(document.querySelectorAll<HTMLElement>('.series-card'));
    const noResultsBox = document.querySelector<HTMLElement>('#no-results');

    if (!searchInput || !noResultsBox) return;

    const noResults = noResultsBox;

    const titleOf = (item: HTMLElement) => item.querySelector('h2')?.textContent?.toLowerCase() ?? '';
    const seriesOf = (item: HTMLElement) => (item.dataset.series ?? '').toLowerCase();

    function setHidden(element: HTMLElement, hidden: boolean) {
      element.classList.toggle('hidden', hidden);
    }

    /** 沒有搜尋字時的預設樣貌：系列卡片全開，只列單篇文章。 */
    function resetToDefault() {
      for (const card of seriesCards) setHidden(card, false);
      for (const item of blogItems) setHidden(item, seriesOf(item) !== '');
      setHidden(noResults, true);
    }

    function applySearch(rawTerm: string) {
      const term = rawTerm.toLowerCase().trim();

      if (term === '') {
        resetToDefault();
        return;
      }

      let matches = 0;

      // 搜尋時把系列文章也納入，命中就顯示（含系列名命中整個系列）
      for (const item of blogItems) {
        const isMatch = titleOf(item).includes(term) || seriesOf(item).includes(term);
        setHidden(item, !isMatch);
        if (isMatch) matches++;
      }

      for (const card of seriesCards) {
        const isMatch = (card.dataset.seriesName ?? '').toLowerCase().includes(term);
        setHidden(card, !isMatch);
        if (isMatch) matches++;
      }

      setHidden(noResults, matches > 0);
    }

    searchInput.addEventListener('input', () => applySearch(searchInput.value));
    // type="search" 的清除鈕會發 search 事件
    searchInput.addEventListener('search', () => applySearch(searchInput.value));

    resetToDefault();
  }

  initBlogSearch();
</script>
