---
import type { GetStaticPaths } from 'astro';
import Layout from '../../../layouts/Layout.astro';
import ArticleListItem from '../../../components/blog/ArticleListItem.astro';
import { generateSeriesList } from '../../../utils/series';
import { ARTICLES_PER_PAGE } from '../../../types/series';

// 每一頁都是真實路徑（/series/foo、/series/foo/2 …），
// 爬蟲與 sitemap 都看得到，不再是前端用 display:none 假裝的分頁。
export const getStaticPaths = (async ({ paginate }) => {
  const seriesList = await generateSeriesList();

  return seriesList.flatMap(series =>
    // series.articles 已是閱讀順序（第一篇在前），沿用它讓頁面順序與上一篇／下一篇一致
    paginate(series.articles, {
      params: { slug: series.slug },
      pageSize: ARTICLES_PER_PAGE,
      props: { series },
    })
  );
}) satisfies GetStaticPaths;

const { series, page } = Astro.props;

const isFirstPage = page.currentPage === 1;
const pageTitle = isFirstPage
  ? `${series.name} - 系列文章`
  : `${series.name} - 系列文章（第 ${page.currentPage} 頁）`;
const description = `${series.name}：共 ${series.count} 篇的系列文章。`;
---

<Layout title={pageTitle} description={description}>
  <section class="mx-auto max-w-3xl px-4 pt-12 sm:px-6 sm:pt-16">
    <nav class="mb-6 text-sm text-muted" aria-label="麵包屑導覽">
      <ol class="flex flex-wrap items-center gap-1">
        <li><a href="/series" class="hover:text-accent">系列文章</a></li>
        <li aria-hidden="true">/</li>
        <li class="text-ink" aria-current="page">{series.name}</li>
      </ol>
    </nav>

    <header class="mb-6 border-b border-line pb-6">
      <p class="text-xs font-medium uppercase tracking-wide text-accent">Series</p>
      <h1 class="mt-2 font-serif text-3xl font-bold leading-tight text-ink sm:text-4xl">{series.name}</h1>
      <p class="mt-3 text-sm text-muted">
        共 {series.count} 篇文章
        {page.lastPage > 1 && <span> · 第 {page.currentPage} / {page.lastPage} 頁</span>}
      </p>
    </header>

    {page.data.length === 0 ? (
      <div class="py-16 text-center">
        <p class="font-serif text-xl text-ink">此系列尚無文章。</p>
        <p class="mt-2 text-muted">請稍後再回來查看更新。</p>
      </div>
    ) : (
      <div class="divide-y divide-line">
        {page.data.map((blog, index) => (
          <ArticleListItem blog={blog} isFirst={isFirstPage && index === 0} showSeries={false} />
        ))}
      </div>
    )}

    {page.lastPage > 1 && (
      <nav class="mt-10 flex items-center justify-between gap-4 border-t border-line pt-6 text-sm" aria-label="分頁導覽">
        {page.url.prev ? (
          <a href={page.url.prev} class="text-ink hover:text-accent" rel="prev">← 上一頁</a>
        ) : (
          <span class="text-muted opacity-50" aria-disabled="true">← 上一頁</span>
        )}
        <span class="text-muted">第 {page.currentPage} 頁，共 {page.lastPage} 頁</span>
        {page.url.next ? (
          <a href={page.url.next} class="text-ink hover:text-accent" rel="next">下一頁 →</a>
        ) : (
          <span class="text-muted opacity-50" aria-disabled="true">下一頁 →</span>
        )}
      </nav>
    )}
  </section>
</Layout>
