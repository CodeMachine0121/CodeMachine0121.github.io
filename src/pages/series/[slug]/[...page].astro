---
import type { GetStaticPaths } from 'astro';
import Layout from '../../../layouts/Layout.astro';
import ArticleListItem from '../../../components/blog/ArticleListItem.astro';
import UiText from '../../../components/common/UiText.astro';
import { formatArticleCount, formatPageOf, inBothLanguages, uiAttributes, uiText } from '../../../utils/ui-language';
import { generateSeriesList } from '../../../utils/series';
import { ARTICLES_PER_PAGE } from '../../../types/series';

// 每一頁都是真實路徑（/series/foo、/series/foo/2 …），
// 爬蟲與 sitemap 都看得到，不再是前端用 display:none 假裝的分頁。
export const getStaticPaths = (async ({ paginate }) => {
  const seriesList = await generateSeriesList();

  return seriesList.flatMap(series =>
    // series.articles 已是閱讀順序（第一篇在前），沿用它讓頁面順序與上一篇／下一篇一致
    paginate(series.articles, {
      params: { slug: series.slug },
      pageSize: ARTICLES_PER_PAGE,
      props: { series },
    })
  );
}) satisfies GetStaticPaths;

const { series, page } = Astro.props;

const isFirstPage = page.currentPage === 1;
const pageTitle = inBothLanguages(language => {
  const base = `${series.name} - ${uiText('pageTitle.series', language)}`;
  if (isFirstPage) return base;
  return language === 'zh' ? `${base}（第 ${page.currentPage} 頁）` : `${base} (page ${page.currentPage})`;
});
const description = `${series.name}：共 ${series.count} 篇的系列文章。`;
---

<Layout title={pageTitle} description={description}>
  <section class="mx-auto max-w-3xl px-4 pt-12 sm:px-6 sm:pt-16">
    <nav class="mb-6 text-sm text-muted" {...uiAttributes({ 'aria-label': 'series.breadcrumb' })}>
      <ol class="flex flex-wrap items-center gap-1">
        <li><a href="/series" class="hover:text-accent"><UiText text="series.overviewTitle" /></a></li>
        <li aria-hidden="true">/</li>
        <li class="text-ink" aria-current="page" data-content>{series.name}</li>
      </ol>
    </nav>

    <header class="mb-6 border-b border-line pb-6">
      <p class="text-xs font-medium uppercase tracking-wide text-accent"><UiText text="series.label" /></p>
      <h1 class="mt-2 font-serif text-3xl font-bold leading-tight text-ink sm:text-4xl" data-content>{series.name}</h1>
      <p class="mt-3 text-sm text-muted">
        <UiText text={inBothLanguages(language => formatArticleCount(series.count, language))} />
        {page.lastPage > 1 && <span> · <UiText text={inBothLanguages(language => formatPageOf(page.currentPage, page.lastPage, language))} /></span>}
      </p>
    </header>

    {page.data.length === 0 ? (
      <div class="py-16 text-center">
        <p class="font-serif text-xl text-ink"><UiText text="series.empty" /></p>
        <p class="mt-2 text-muted"><UiText text="series.checkBack" /></p>
      </div>
    ) : (
      <div class="divide-y divide-line">
        {page.data.map((blog, index) => (
          <ArticleListItem blog={blog} isFirst={isFirstPage && index === 0} showSeries={false} />
        ))}
      </div>
    )}

    {page.lastPage > 1 && (
      <nav class="mt-10 flex items-center justify-between gap-4 border-t border-line pt-6 text-sm" {...uiAttributes({ 'aria-label': 'pagination.label' })}>
        {page.url.prev ? (
          <a href={page.url.prev} class="text-ink hover:text-accent" rel="prev"><UiText text="pagination.previous" /></a>
        ) : (
          <span class="text-muted opacity-50" aria-disabled="true"><UiText text="pagination.previous" /></span>
        )}
        <span class="text-muted"><UiText text={inBothLanguages(language => formatPageOf(page.currentPage, page.lastPage, language))} /></span>
        {page.url.next ? (
          <a href={page.url.next} class="text-ink hover:text-accent" rel="next"><UiText text="pagination.next" /></a>
        ) : (
          <span class="text-muted opacity-50" aria-disabled="true"><UiText text="pagination.next" /></span>
        )}
      </nav>
    )}
  </section>
</Layout>
