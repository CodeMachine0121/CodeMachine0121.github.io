---
import Layout from "../layouts/Layout.astro";
import SeriesCard from "../components/blog/SeriesCard.astro";
import UiText from "../components/common/UiText.astro";
import { generateSeriesList } from "../utils/series";
import { localize } from "../utils/ui-language";

const seriesList = await generateSeriesList();
---

<Layout title={localize("pageTitle.series")}>
  <section class="mx-auto max-w-4xl px-4 pt-12 sm:px-6 sm:pt-16">
    <header class="mb-8">
      <h1 class="font-serif text-3xl font-bold text-ink sm:text-4xl"><UiText text="series.overviewTitle" /></h1>
      <p class="mt-2 text-muted"><UiText text="series.overviewSubtitle" /></p>
    </header>

    {seriesList.length === 0 ? (
      <p class="py-16 text-center text-muted"><UiText text="series.none" /></p>
    ) : (
      <ul class="grid gap-6 sm:grid-cols-2">
        {seriesList.map((series, index) => (
          <li><SeriesCard series={series} eager={index < 2} /></li>
        ))}
      </ul>
    )}
  </section>
</Layout>
