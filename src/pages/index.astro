---
import Layout from '../layouts/Layout.astro';
import Intro from '../components/home/Intro.astro';
import LatestArticles from '../components/home/LatestArticles.astro';
import ProjectList from '../components/home/ProjectList.astro';
import ExperienceSummary from '../components/home/ExperienceSummary.astro';
import { getPublishedBlogs } from '../utils/series';

const publishedBlogs = await getPublishedBlogs();
---

<Layout
	title="Coding Afternoon"
	description="James Hsueh 的技術部落格與作品集：軟體架構、測試驅動開發、AI 協作與日常踩坑筆記。"
>
	<Intro />
	<LatestArticles blogs={publishedBlogs} />
	<ProjectList />
	<ExperienceSummary />
</Layout>
