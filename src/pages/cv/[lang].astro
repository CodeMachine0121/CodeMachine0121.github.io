---
import CVHeader from '../../components/cv/CVHeader.astro';
import CVLookingFor from '../../components/cv/CVLookingFor.astro';
import CVSummary from '../../components/cv/CVSummary.astro';
import CVSkills from '../../components/cv/CVSkills.astro';
import CVExperience from '../../components/cv/CVExperience.astro';
import CVEducation from '../../components/cv/CVEducation.astro';
import CVProjects from '../../components/cv/CVProjects.astro';
import DownloadButton from '../../components/cv/DownloadButton.astro';
import LanguageSwitcher from '../../components/cv/LanguageSwitcher.astro';
import profilePicture from '../../assets/profile-picture.png';
import cvData from '../../config/cv.json';
import { getLocalizedText, isValidLanguage } from '../../utils/i18n';
import { uiText } from '../../utils/ui-language';
import type { Language } from '../../types/cv';
import SiteFonts from '../../components/common/SiteFonts.astro';
import ThemeInit from '../../components/common/ThemeInit.astro';
import ThemeToggle from '../../components/common/ThemeToggle.astro';
import '../../styles/tokens.css';
import '../../styles/cv.scss';

export function getStaticPaths() {
  return [
    { params: { lang: 'en' } },
    { params: { lang: 'zh' } },
  ];
}

const { lang } = Astro.params;
const language: Language = isValidLanguage(lang) ? lang : 'en';

const { basic, skills, experiences, projects, talks, writing, certifications, education, socialLinks } = cvData;
const htmlLang = language === 'zh' ? 'zh-TW' : 'en';

const talksTitle = language === 'zh' ? '研討會演講' : 'Conference Talks';
const writingTitle = language === 'zh' ? '寫作' : 'Writing';
const certificationsTitle = language === 'zh' ? '認證' : 'Certifications';
// The browser's print dialog derives the suggested PDF filename from <title>.
const pageTitle = `${basic.name} - ${basic.job} - CV`;
---

<!doctype html>
<html lang={htmlLang} data-language={language}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={`${basic.name} – Curriculum Vitae`} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <SiteFonts />

    <title>{pageTitle}</title>

    <ThemeInit />

    <!--
      Marks that JS is running, which is what lets the entrance animation hide
      sections in the first place. Inline and in the head so it lands before
      first paint (no flash of hidden content); without it the CV stays visible.
    -->
    <script is:inline>document.documentElement.classList.add('cv-js');</script>
  </head>

  <body>
    <!-- Back to Home -->
    <a href="/" class="no-print cv-back-link" aria-label={uiText('cv.backToHome', language)}>
      <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/>
      </svg>
      {uiText('cv.home', language)}
    </a>

    <!-- Download PDF & Language Switcher -->
    <div class="cv-toolbar no-print">
      <DownloadButton label={language === 'zh' ? '存成 PDF' : 'Save as PDF'} />
      <LanguageSwitcher currentLang={language} />
      <ThemeToggle />
    </div>

    <!-- CV Paper -->
    <div class="flex justify-center px-4 pt-14 pb-16">
      <div id="cv-content" class="cv-paper">
        <CVHeader basic={basic} socialLinks={socialLinks} profilePicture={profilePicture} />

        {basic.looking_for && (
          <CVLookingFor text={getLocalizedText(basic.looking_for, language)} lang={language} />
        )}
        <CVSummary summary={getLocalizedText(basic.summary, language)} lang={language} />
        {skills && skills.length > 0 && <CVSkills groups={skills} lang={language} />}
        <CVExperience items={experiences} lang={language} />
        <CVProjects items={projects} lang={language} />
        {talks && talks.length > 0 && <CVExperience items={talks} lang={language} title={talksTitle} />}
        {writing && writing.length > 0 && <CVExperience items={writing} lang={language} title={writingTitle} />}
        {certifications && certifications.length > 0 && (
          <CVExperience items={certifications} lang={language} title={certificationsTitle} />
        )}
        <CVEducation items={education} lang={language} />
      </div>
    </div>

    <!-- Intersection Observer for entrance animations -->
    <script>
      const sections = document.querySelectorAll('.cv-animate');

      const reveal = (el: Element, delayMs = 0) => {
        (el as HTMLElement).style.animationDelay = `${delayMs}ms`;
        el.classList.add('is-visible');
      };

      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry, i) => {
            if (entry.isIntersecting) {
              reveal(entry.target, i * 40);
              observer.unobserve(entry.target);
            }
          });
        },
        { threshold: 0.05 }
      );

      sections.forEach(el => observer.observe(el));

      // Failsafe: the whole CV below the header is animated, so anything that
      // stops the observer from firing — a zero-height viewport in a headless
      // renderer, a bot that never scrolls — would hide the entire document.
      // Reveal unconditionally shortly after load and stop observing.
      window.setTimeout(() => {
        sections.forEach(el => {
          observer.unobserve(el);
          if (!el.classList.contains('is-visible')) reveal(el);
        });
      }, 1200);
    </script>
      <script>
      // 履歷的語言由網址決定（<html data-language> 已在伺服器端寫好），這裡只把
      // 共用元件（例如主題切換鈕）的無障礙名稱換成該語言
      import { applyLanguage, currentLanguage } from '../../scripts/language';
      applyLanguage(currentLanguage());
    </script>
  </body>
</html>
