---
import { render } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import 'katex/dist/katex.min.css';
import '../../styles/article.css';

import Layout from '../../layouts/Layout.astro';
import ArticleMeta from '../../components/blog/ArticleMeta.astro';
import TableOfContents from '../../components/blog/TableOfContents.astro';
import PostNavigation from '../../components/blog/PostNavigation.astro';
import ReadingProgress from '../../components/common/ReadingProgress.astro';
import GiscusComments from '../../components/common/GiscusComments.astro';
import BackToTop from '../../components/common/BackToTop.astro';
import { createSlug } from '../../utils/slugify';
import { getAdjacentPosts, getAdjacentSeriesPosts, getPublishedBlogs } from '../../utils/series';

export const getStaticPaths = (async () => {
    const blogs = await getPublishedBlogs();
    return blogs.map(blog => ({
        params: { slug: blog.id },
        props: { blog }
    }));
}) satisfies GetStaticPaths;

const { blog } = Astro.props;
const { Content, headings } = await render(blog);
const seriesName = blog.data.parent;

// 「上一篇／下一篇」走閱讀順序：系列是第一篇→最後一篇，單篇是最新→最舊。
// 兩者方向不同是刻意的，詳見 utils/series-core.ts 的 findAdjacent。
const { prevPost, nextPost } = seriesName
    ? await getAdjacentSeriesPosts(blog.id, seriesName)
    : await getAdjacentPosts(blog.id);
---

<Layout
    title={blog.data.title}
    description={blog.data.description}
    image={blog.data.image}
    type="article"
    publishedTime={blog.data.datetime}
>
    <ReadingProgress />
    <article class="article-layout mx-auto max-w-page px-4 pt-10 sm:px-6 sm:pt-14">
        <header class="article-layout__main mb-8">
            {seriesName && (
                <a href={`/series/${createSlug(seriesName)}`} class="text-xs font-medium uppercase tracking-wide text-accent hover:underline" data-content>
                    {seriesName}
                </a>
            )}
            <h1 class="mt-2 font-serif text-3xl font-bold leading-tight text-ink sm:text-4xl" data-content>{blog.data.title}</h1>
            {blog.data.description && (
                <p class="mt-4 text-lg leading-relaxed text-muted" data-content>{blog.data.description}</p>
            )}
            <ArticleMeta blog={blog} class="mt-5 border-b border-line pb-6" />
        </header>

        {blog.data.image && (
            <img
                src={blog.data.image}
                alt={blog.data.title}
                loading="eager"
                class="article-layout__main mb-10 max-h-96 w-full rounded object-cover"
            />
        )}

        <div class="article-layout__toc">
            <TableOfContents headings={headings} />
        </div>

        <div class="article-layout__main prose article-body" data-content>
            <Content />
        </div>

        <footer class="article-layout__main">
            <GiscusComments />
            <PostNavigation {prevPost} {nextPost} />
        </footer>
    </article>
    <BackToTop />

    <script>
        import "../../scripts/mobileFixes";
        import "../../scripts/mermaid";
        import "../../scripts/codeCopy";
    </script>
</Layout>

